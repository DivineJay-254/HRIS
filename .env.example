# ============================================================
# HRIS Platform — Environment Variable Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is gitignored.
# ============================================================

# Firebase client config (not secrets — safe in client bundle)
# Find these in Firebase Console → Project Settings → Your apps
REACT_APP_FIREBASE_API_KEY=your-api-key-here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
REACT_APP_FIREBASE_APP_ID=your-app-id

# Set to true to point all Firebase SDK calls to the local emulator suite
# Leave unset or false in production
REACT_APP_USE_EMULATOR=false
